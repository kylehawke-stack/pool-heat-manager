# OwnerRez — Personal Access Token (bookings, properties, guests).
# Settings -> Developer/API -> Personal Access Tokens.
OWNERREZ_PAT_EMAIL=you@example.com
OWNERREZ_PAT_TOKEN=pt_your_personal_access_token

# OwnerRez — OAuth app. REQUIRED for reading guest messages: Personal Access
# Tokens get HTTP 402 messaging_not_enabled on /v2/messages. Self-use is free —
# Settings -> Developer/API -> create an app (scope Full, expiration Standard),
# then on its Users tab click "Grant Access To Me". Authorise with:
#   npm run orz:auth
OWNERREZ_CLIENT_ID=c_your_client_id
OWNERREZ_CLIENT_SECRET=s_your_client_secret

# Pentair ScreenLogic (cloud relay credentials - same as your ScreenLogic app login)
PENTAIR_EMAIL=your_pentair_email
PENTAIR_PASSWORD=your_pentair_password

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1234567890

# Resend (email alerts)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_ADDRESS=Pool Heat Manager <alerts@yourdomain.com>
ALERT_EMAIL=your_email@gmail.com

# Server
PORT=3100
# Must match the Webhook User/Password set on the OwnerRez OAuth app.
WEBHOOK_LOGIN=your_webhook_login
WEBHOOK_PASSWORD=your_webhook_password
# Public base URL for links in confirm/override emails (e.g. https://pool.yourdomain.com)
PUBLIC_URL=

# Anthropic (optional — message classification)
ANTHROPIC_API_KEY=

# Pool target temperature (°F)
DEFAULT_TARGET_TEMP=85
