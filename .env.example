# Hostaway API
HOSTAWAY_CLIENT_ID=your_account_id
HOSTAWAY_CLIENT_SECRET=your_api_secret

# Pentair ScreenLogic (cloud relay credentials - same as your ScreenLogic app login)
PENTAIR_EMAIL=your_pentair_email
PENTAIR_PASSWORD=your_pentair_password

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1234567890

# Resend (email alerts)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_ADDRESS=Pool Heat Manager <alerts@yourdomain.com>
ALERT_EMAIL=your_email@gmail.com

# Server
PORT=3100
WEBHOOK_LOGIN=your_webhook_login
WEBHOOK_PASSWORD=your_webhook_password
# Public base URL for links in confirm/override emails (e.g. https://pool.yourdomain.com)
PUBLIC_URL=

# Anthropic (optional — message classification)
ANTHROPIC_API_KEY=

# Pool target temperature (°F)
DEFAULT_TARGET_TEMP=85
